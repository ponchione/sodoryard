{
  "name": "@sodoryard/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron --no-sandbox .",
    "package:unpacked": "npm run build && node scripts/package-unpacked.mjs",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "electron": "^42.0.1",
    "typescript": "~5.9.3"
  }
}
